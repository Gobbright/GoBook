NODE_ENV=development
PORT=5000

CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

MONGODB_URI=mongodb://localhost:27017/gobook
MONGODB_DB_NAME=gobook
MONGODB_STORAGE_LIMIT_MB=
# Optional: comma-separated DNS servers when the local resolver blocks MongoDB SRV lookups.
DNS_SERVERS=

JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

ADMIN_LOGIN_ID=admin
ADMIN_LOGIN_PASSWORD=change-me
ADMIN_JWT_EXPIRES_IN=8h
# Must match frontend VITE_GOOGLE_CLIENT_ID. CORS does not register Google OAuth origins.
# Production setup: ../GOOGLE_SIGNIN_DEPLOYMENT.md
GOOGLE_CLIENT_ID=


# Set to false to skip Razorpay checkout and activate accounts without payment
PAYMENT_REQUIRED=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support.gobook@gmail.com
SMTP_PASS=
SMTP_FROM=GoBook Support <support.gobook@gmail.com>
SMTP_TIMEOUT_MS=20000

# Meta / WhatsApp: backend only. See ../META_WHATSAPP_DEPLOYMENT.md.
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business configuration with standard WhatsApp Embedded Signup.
META_LOGIN_CONFIG_ID=
# Set an active Graph API version supported by your Meta app.
META_GRAPH_API_VERSION=
# 32 random bytes encoded as 64 hex characters; store in the hosting secret manager.
META_TOKEN_ENCRYPTION_KEY=
META_PUBLIC_ORIGIN=https://www.gobooksuite.com
