NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-url>/?appName=Cluster0
MONGODB_DB_NAME=gobook
# Optional hosted database quota. Leave blank to show MongoDB server filesystem free space.
MONGODB_STORAGE_LIMIT_MB=
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
ADMIN_LOGIN_ID=admin
ADMIN_LOGIN_PASSWORD=change-me
ADMIN_JWT_EXPIRES_IN=8h
GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support.gobook@gmail.com
SMTP_PASS=
SMTP_FROM=GoBook Support <support.gobook@gmail.com>
SMTP_TIMEOUT_MS=20000
